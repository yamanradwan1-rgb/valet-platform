{
  "name": "valet-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "node scripts/build/run-build.mjs verification",
    "build:production": "node scripts/build/run-build.mjs production",
    "test": "node scripts/test-harness/run-root-tests.mjs",
    "test:non-postgres": "node scripts/test-harness/run-root-tests.mjs --non-postgres-only",
    "test:postgres": "node scripts/test-harness/run-root-tests.mjs --postgres-only",
    "test:postgres:api": "pnpm --filter @valet/api test:postgres",
    "test:postgres:database": "pnpm --filter @valet/database test:postgres",
    "test:build-contract": "node --test scripts/build/build-contract.test.mjs",
    "test:platform": "pnpm --filter @valet/api exec node ../../scripts/test-harness/run-owned-tests.mjs api vitest.config.mjs test/architecture-repository-files.test.ts test/architecture-check.test.ts test/architecture-line-policy.test.ts test/capacity-harness.test.ts test/capacity-process-sampler.test.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "architecture:check": "node scripts/architecture-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "local:bootstrap": "pnpm --filter @valet/api local:bootstrap",
    "mobile:poc": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile-poc.ps1",
    "local:status": "pnpm --filter @valet/api local:status",
    "local:smoke": "pnpm --filter @valet/api local:smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "turbo": "2.10.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "4.1.10"
  }
}
