{
  "name": "valet-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "architecture:check": "node scripts/architecture-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "local:bootstrap": "pnpm --filter @valet/api local:bootstrap",
    "mobile:poc": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile-poc.ps1",
    "local:status": "pnpm --filter @valet/api local:status",
    "local:smoke": "pnpm --filter @valet/api local:smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "turbo": "2.10.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "4.1.10"
  }
}
