diff --git a/android/src/main/java/expo/modules/camera/PlateRoiMetadata.kt b/android/src/main/java/expo/modules/camera/PlateRoiMetadata.kt
new file mode 100644
index 0000000000000000000000000000000000000000..2882a61744b1de4f30ea71724c49f78b54ff3891
--- /dev/null
+++ b/android/src/main/java/expo/modules/camera/PlateRoiMetadata.kt
@@ -0,0 +1,150 @@
+package expo.modules.camera
+
+import android.graphics.Matrix
+import android.os.Bundle
+import androidx.camera.core.ImageProxy
+import androidx.camera.view.PreviewView
+import expo.modules.kotlin.records.Field
+import expo.modules.kotlin.records.Record
+
+/** Issue #213 only: identifiers are ephemeral callback fences, never authority. */
+data class PlateRoiRequest(
+  @Field val generation: Int = 0,
+  @Field val mountId: Int = 0,
+  @Field val revision: Int = 0
+) : Record
+
+enum class PlateRoiFailure(val code: String) {
+  REAR_CAMERA_MISMATCH("OCR_CAPTURE_METADATA_REAR_CAMERA_MISMATCH"),
+  PREVIEW_METADATA_MISSING("OCR_CAPTURE_METADATA_PREVIEW_METADATA_MISSING"),
+  CAPTURE_USE_CASE_MISSING("OCR_CAPTURE_METADATA_CAPTURE_USE_CASE_MISSING"),
+  CAMERA_CHANGED("OCR_CAPTURE_METADATA_CAMERA_CHANGED"),
+  CAPTURE_USE_CASE_CHANGED("OCR_CAPTURE_METADATA_CAPTURE_USE_CASE_CHANGED"),
+  PREVIEW_CHANGED("OCR_CAPTURE_METADATA_PREVIEW_CHANGED"),
+  PREVIEW_TO_BUFFER_INVALID("OCR_CAPTURE_METADATA_PREVIEW_TO_BUFFER_INVALID"),
+  PROCESSING_GUARD_REJECTED("OCR_CAPTURE_METADATA_PROCESSING_GUARD_REJECTED"),
+  RAW_SIZE_MISMATCH("OCR_CAPTURE_METADATA_RAW_SIZE_MISMATCH"),
+  ROTATION_MISMATCH("OCR_CAPTURE_METADATA_ROTATION_MISMATCH"),
+  OUTPUT_SIZE_MISMATCH("OCR_CAPTURE_METADATA_OUTPUT_SIZE_MISMATCH"),
+  PROCESSED_MATRIX_INVALID("OCR_CAPTURE_METADATA_PROCESSED_MATRIX_INVALID"),
+  PROCESSING_OOM("OCR_CAPTURE_METADATA_PROCESSING_OOM"),
+  CAPTURE_METADATA_MISSING("OCR_CAPTURE_METADATA_CAPTURE_METADATA_MISSING")
+}
+
+data class PlateRoiCaptureResult(
+  val metadata: PlateRoiMetadata? = null,
+  val failure: PlateRoiFailure? = null
+)
+
+data class PlateRoiProcessedResult(
+  val metadata: Bundle? = null,
+  val failure: PlateRoiFailure? = null
+)
+
+class PlateRoiPreview private constructor(
+  val width: Int,
+  val height: Int,
+  private val sensorToView: Matrix
+) {
+  fun matches(other: PlateRoiPreview?): Boolean = other != null &&
+    width == other.width && height == other.height &&
+    values(sensorToView).contentEquals(values(other.sensorToView))
+
+  fun describe(): Bundle = Bundle().apply {
+    putInt("width", width)
+    putInt("height", height)
+    putDoubleArray("sensorToView", values(sensorToView).map { it.toDouble() }.toDoubleArray())
+  }
+
+  fun capture(image: ImageProxy, request: PlateRoiRequest): PlateRoiCaptureResult {
+    val inverse = Matrix()
+    if (!sensorToView.invert(inverse))
+      return PlateRoiCaptureResult(failure = PlateRoiFailure.PREVIEW_TO_BUFFER_INVALID)
+    val previewToBuffer = Matrix().apply {
+      setConcat(image.imageInfo.sensorToBufferTransformMatrix, inverse)
+    }
+    if (!valid(previewToBuffer))
+      return PlateRoiCaptureResult(failure = PlateRoiFailure.PREVIEW_TO_BUFFER_INVALID)
+    return PlateRoiCaptureResult(
+      metadata = PlateRoiMetadata(
+        request, width, height, image.width, image.height,
+        image.imageInfo.rotationDegrees, previewToBuffer
+      )
+    )
+  }
+
+  companion object {
+    fun snapshot(view: PreviewView): PlateRoiPreview? {
+      val transform = view.sensorToViewTransform ?: return null
+      if (view.width <= 0 || view.height <= 0 || !valid(transform)) return null
+      return PlateRoiPreview(view.width, view.height, Matrix(transform))
+    }
+
+    fun values(matrix: Matrix): FloatArray = FloatArray(9).also(matrix::getValues)
+
+    fun valid(matrix: Matrix): Boolean =
+      values(matrix).all { it.isFinite() } && matrix.invert(Matrix())
+  }
+}
+
+/** No guessed center-cover relationship and no change to CameraX use-case binding. */
+class PlateRoiMetadata(
+  private val request: PlateRoiRequest,
+  private val previewWidth: Int,
+  private val previewHeight: Int,
+  private val bufferWidth: Int,
+  private val bufferHeight: Int,
+  private val rotation: Int,
+  private val previewToBuffer: Matrix
+) {
+  private var processingValid = true
+
+  fun rejectProcessing() { processingValid = false }
+
+  fun processed(
+    rawWidth: Int, rawHeight: Int, appliedRotation: Int,
+    outputWidth: Int, outputHeight: Int
+  ): Bundle? = processedResult(
+    rawWidth, rawHeight, appliedRotation, outputWidth, outputHeight
+  ).metadata
+
+  fun processedResult(
+    rawWidth: Int, rawHeight: Int, appliedRotation: Int,
+    outputWidth: Int, outputHeight: Int
+  ): PlateRoiProcessedResult {
+    if (!processingValid)
+      return PlateRoiProcessedResult(failure = PlateRoiFailure.PROCESSING_OOM)
+    if (rawWidth != bufferWidth || rawHeight != bufferHeight || bufferWidth <= 0 || bufferHeight <= 0)
+      return PlateRoiProcessedResult(failure = PlateRoiFailure.RAW_SIZE_MISMATCH)
+    if (appliedRotation != rotation)
+      return PlateRoiProcessedResult(failure = PlateRoiFailure.ROTATION_MISMATCH)
+    val quarterTurn = rotation == 90 || rotation == 270
+    val expectedWidth = if (quarterTurn) bufferHeight else bufferWidth
+    val expectedHeight = if (quarterTurn) bufferWidth else bufferHeight
+    if (outputWidth != expectedWidth || outputHeight != expectedHeight)
+      return PlateRoiProcessedResult(failure = PlateRoiFailure.OUTPUT_SIZE_MISMATCH)
+    val rotationValues = when (rotation) {
+      0 -> floatArrayOf(1f, 0f, 0f, 0f, 1f, 0f, 0f, 0f, 1f)
+      90 -> floatArrayOf(0f, -1f, bufferHeight.toFloat(), 1f, 0f, 0f, 0f, 0f, 1f)
+      180 -> floatArrayOf(-1f, 0f, bufferWidth.toFloat(), 0f, -1f, bufferHeight.toFloat(), 0f, 0f, 1f)
+      270 -> floatArrayOf(0f, 1f, 0f, -1f, 0f, bufferWidth.toFloat(), 0f, 0f, 1f)
+      else -> return PlateRoiProcessedResult(failure = PlateRoiFailure.ROTATION_MISMATCH)
+    }
+    val upright = Matrix().apply { setValues(rotationValues) }
+    val mapping = Matrix().apply { setConcat(upright, previewToBuffer) }
+    if (!PlateRoiPreview.valid(mapping))
+      return PlateRoiProcessedResult(failure = PlateRoiFailure.PROCESSED_MATRIX_INVALID)
+    return PlateRoiProcessedResult(
+      metadata = Bundle().apply {
+        putInt("generation", request.generation)
+        putInt("mountId", request.mountId)
+        putInt("revision", request.revision)
+        putInt("previewWidth", previewWidth)
+        putInt("previewHeight", previewHeight)
+        putInt("imageWidth", outputWidth)
+        putInt("imageHeight", outputHeight)
+        putDoubleArray("previewToImage", PlateRoiPreview.values(mapping).map { it.toDouble() }.toDoubleArray())
+      }
+    )
+  }
+}
