diff --git a/android/src/test/java/expo/modules/camera/PlateRoiMetadataTest.kt b/android/src/test/java/expo/modules/camera/PlateRoiMetadataTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..2962b1db701fe5eb148740fe63c7c56b63bd9540
--- /dev/null
+++ b/android/src/test/java/expo/modules/camera/PlateRoiMetadataTest.kt
@@ -0,0 +1,98 @@
+package expo.modules.camera
+
+import android.graphics.Matrix
+import androidx.camera.core.ImageInfo
+import androidx.camera.core.ImageProxy
+import java.lang.reflect.Proxy
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [29], manifest = Config.NONE)
+class PlateRoiMetadataTest {
+  private fun metadata(rotation: Int = 0): PlateRoiMetadata {
+    val mapping = Matrix().apply { setValues(floatArrayOf(2f, 0f, 10f, 0f, 3f, 20f, 0f, 0f, 1f)) }
+    return PlateRoiMetadata(PlateRoiRequest(5, 7, 9), 360, 260, 1000, 800, rotation, mapping)
+  }
+
+  @Test fun actualUprightRotationMapsAsymmetricPoint() {
+    val cases = mapOf(0 to floatArrayOf(30f, 80f), 90 to floatArrayOf(720f, 30f),
+      180 to floatArrayOf(970f, 720f), 270 to floatArrayOf(80f, 970f))
+    for ((rotation, expected) in cases) {
+      val quarter = rotation == 90 || rotation == 270
+      val result = metadata(rotation).processed(1000, 800, rotation,
+        if (quarter) 800 else 1000, if (quarter) 1000 else 800)!!
+      val matrix = Matrix().apply {
+        setValues(result.getDoubleArray("previewToImage")!!.map { it.toFloat() }.toFloatArray())
+      }
+      val point = floatArrayOf(10f, 20f)
+      matrix.mapPoints(point)
+      assertArrayEquals(expected, point, 0.0001f)
+      assertEquals(5, result.getInt("generation"))
+      assertEquals(7, result.getInt("mountId"))
+      assertEquals(9, result.getInt("revision"))
+    }
+  }
+
+  @Test fun rejectsProcessingThatDoesNotMatchCapturedBuffer() {
+    assertNull(metadata().processed(999, 800, 0, 1000, 800))
+    assertNull(metadata(90).processed(1000, 800, 0, 800, 1000))
+    assertNull(metadata(90).processed(1000, 800, 90, 1000, 800))
+    assertNull(metadata(45).processed(1000, 800, 45, 1000, 800))
+    val failed = metadata(180)
+    failed.rejectProcessing()
+    assertNull(failed.processed(1000, 800, 180, 1000, 800))
+  }
+
+  @Test fun singularOrNonFiniteMatricesAreRejected() {
+    assertFalse(PlateRoiPreview.valid(Matrix().apply { setScale(0f, 1f) }))
+    assertFalse(PlateRoiPreview.valid(Matrix().apply { setScale(Float.NaN, 1f) }))
+    assertTrue(PlateRoiPreview.valid(Matrix()))
+  }
+
+  @Test fun composesActualCaptureAndPreviewSensorTransforms() {
+    val sensorToView = Matrix().apply {
+      setValues(floatArrayOf(0.5f, 0f, 11f, 0f, 0.75f, 13f, 0f, 0f, 1f))
+    }
+    val constructor = PlateRoiPreview::class.java.getDeclaredConstructor(
+      Int::class.javaPrimitiveType, Int::class.javaPrimitiveType, Matrix::class.java
+    ).apply { isAccessible = true }
+    val preview = constructor.newInstance(360, 260, sensorToView)
+    val sensorToBuffer = Matrix().apply {
+      setValues(floatArrayOf(2f, 0f, 70f, 0f, 3f, 90f, 0f, 0f, 1f))
+    }
+    val info = Proxy.newProxyInstance(ImageInfo::class.java.classLoader,
+      arrayOf(ImageInfo::class.java)) { _, method, _ ->
+      when (method.name) {
+        "getSensorToBufferTransformMatrix" -> sensorToBuffer
+        "getRotationDegrees" -> 0
+        else -> error("Unexpected image-info access")
+      }
+    } as ImageInfo
+    val image = Proxy.newProxyInstance(ImageProxy::class.java.classLoader,
+      arrayOf(ImageProxy::class.java)) { _, method, _ ->
+      when (method.name) {
+        "getImageInfo" -> info
+        "getWidth" -> 1000
+        "getHeight" -> 800
+        else -> error("Unexpected image-buffer access")
+      }
+    } as ImageProxy
+    val result = preview.capture(image, PlateRoiRequest(5, 7, 9))!!
+      .processed(1000, 800, 0, 1000, 800)!!
+    val matrix = Matrix().apply {
+      setValues(result.getDoubleArray("previewToImage")!!.map { it.toFloat() }.toFloatArray())
+    }
+    val point = floatArrayOf(10f, 20f)
+    matrix.mapPoints(point)
+    assertArrayEquals(floatArrayOf(66f, 118f), point, 0.0001f)
+    assertTrue(preview.matches(constructor.newInstance(360, 260, Matrix(sensorToView))))
+    assertFalse(preview.matches(constructor.newInstance(361, 260, sensorToView)))
+    assertFalse(preview.matches(constructor.newInstance(360, 260, sensorToBuffer)))
+    assertFalse(preview.matches(null))
+  }
+
+}
