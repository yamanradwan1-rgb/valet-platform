# Runtime
NODE_ENV=development
VAYLET_ALLOW_DEMO_SEED=false

# Database
POSTGRES_USER=valet_admin
POSTGRES_PASSWORD=change-this-local-dev-password
POSTGRES_DB=valet
MIGRATION_DATABASE_URL=postgresql://valet_admin:change-this-local-dev-password@127.0.0.1:5432/valet
DATABASE_URL=postgresql://valet_runtime:change-this-runtime-local-dev-password@127.0.0.1:5432/valet

# Staff auth (comma-separated canonical origins; no wildcard)
STAFF_AUTH_ALLOWED_ORIGINS=https://staff.example.com

# Shared durable anti-abuse (43-char unpadded base64url secret = 32 random bytes)
ANTI_ABUSE_HMAC_SECRET_B64URL=
# Comma-separated explicit trusted proxy CIDRs; empty uses the socket peer directly
ANTI_ABUSE_TRUSTED_PROXY_CIDRS=

# Object storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Notifications
SMS_PROVIDER=mock

# Payments
PAYMENT_PROVIDER=disabled
