# Runtime
NODE_ENV=development
VAYLET_ALLOW_DEMO_SEED=false
# Server-only origin used by Employee/Customer same-origin API proxies.
# Required explicitly in production; a private loopback origin is supported.
API_ORIGIN=http://localhost:3001

# Database
POSTGRES_USER=valet_admin
POSTGRES_PASSWORD=change-this-local-dev-password
POSTGRES_DB=valet
MIGRATION_DATABASE_URL=postgresql://valet_admin:change-this-local-dev-password@127.0.0.1:5432/valet
DATABASE_URL=postgresql://valet_runtime:change-this-runtime-local-dev-password@127.0.0.1:5432/valet
# Production API processes must omit MIGRATION_DATABASE_URL entirely.
# Production migration jobs require: ?sslmode=require&sslaccept=strict
# Optional migration custom CA: append an encoded deployment-host-native absolute
# filesystem path; relative or foreign-platform-only path syntax fails.
# Optional runtime custom CA: inject a non-empty PEM bundle as a multiline secret.
# When system roots validate the server, omit DATABASE_TLS_CA_PEM in production.
DATABASE_TLS_CA_PEM=

# Staff auth (comma-separated canonical origins; no wildcard)
STAFF_AUTH_ALLOWED_ORIGINS=https://staff.example.com
# MGT-BE-02 MFA server secrets. Production must provision both before API start.
# Each value is exactly 32 random bytes encoded as canonical unpadded base64url
# (43 characters). Generate independently; do not reuse either key.
MFA_TOTP_ENCRYPTION_KEY_B64URL=
MFA_RECOVERY_HMAC_SECRET_B64URL=
# LOCAL DEVELOPMENT ONLY. Default false; never enable in production.
# Bypasses MFA enrollment/assurance/step-up gating only.
# Authentication and authorization remain enforced.
VAYLET_LOCAL_DISABLE_MFA=false

# Customer app origin for Guest Access links (absolute clean origin).
# Must be a bare origin: no path, query or fragment. Production requires
# HTTPS; local development may use http://localhost:<port>.
NEXT_PUBLIC_CUSTOMER_APP_ORIGIN=http://localhost:3002
# Guest Browser Session T1 rollout. Keep new enrollment disabled until the
# staged rollout gates are satisfied. The API origin allowlist must name the
# exact public Customer origin; no wildcard/reflected origins are accepted.
GUEST_BROWSER_SESSION_ENROLLMENT_ENABLED=false
GUEST_AUTH_ALLOWED_ORIGINS=http://localhost:3002
NEXT_PUBLIC_GUEST_BROWSER_SESSION_ENROLLMENT_ENABLED=false
# Optional Dashboard browser map configuration; injected when building Next.js.
# Restrict the public key to Maps JavaScript API and deployed HTTPS referrers.
# Never put a server key here. Missing configuration keeps manual zones usable.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Employee Native uses its own Expo public configuration boundary. It follows
# the same validation rules and is required only for Native Guest Access share
# surfaces. Development may use the localhost value below. Release must
# explicitly replace it with the real deployed bare HTTPS Customer App origin;
# Expo release configuration fails before bundling if it remains invalid.
EXPO_PUBLIC_CUSTOMER_APP_ORIGIN=http://localhost:3002

# Shared durable anti-abuse (43-char unpadded base64url secret = 32 random bytes)
ANTI_ABUSE_HMAC_SECRET_B64URL=
HANDOFF_VERIFIER_HMAC_SECRET_B64URL=
# Comma-separated explicit trusted proxy CIDRs; empty uses the socket peer directly
ANTI_ABUSE_TRUSTED_PROXY_CIDRS=

# Object storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Notifications
SMS_PROVIDER=mock
# Staff Push DEC-075 policy. Both switches are explicit and independent.
STAFF_PUSH_RETRIEVAL_CREATION_ENABLED=false
STAFF_PUSH_WORKER_SENDING_ENABLED=false
STAFF_PUSH_RETRIEVAL_POLICY_VERSION=1
STAFF_PUSH_RETRIEVAL_INTENT_TTL_SECONDS=300
STAFF_PUSH_RETRIEVAL_MAX_ATTEMPTS=4
STAFF_PUSH_PROVIDER_CALL_TIMEOUT_SECONDS=10
STAFF_PUSH_LEASE_DURATION_SECONDS=30
STAFF_PUSH_RETRY_MINIMUM_SECONDS=10
STAFF_PUSH_RETRY_CAP_SECONDS=60
STAFF_PUSH_INTENT_DELIVERY_RETENTION_DAYS=7
STAFF_PUSH_TERMINAL_REGISTRATION_RETENTION_DAYS=30
STAFF_PUSH_ACTIVE_REGISTRATION_STALE_DAYS=30
STAFF_PUSH_CLEANUP_INTERVAL_HOURS=24
# Required only when worker sending is enabled; non-secret deployment project ID.
STAFF_PUSH_FCM_PROJECT_ID=
# ADC credentials remain externally mounted/injected; never paste JSON here.

# Guest Web Push v1, Accepted DEC-101. Separate from Staff Push and from
# GUEST_BROWSER_SESSION_ENROLLMENT_ENABLED. Both default off until authorized
# forward migration, real Customer HTTPS origin, operational worker and
# supported physical device matrix have been qualified.
GUEST_PUSH_REGISTRATION_ENABLED=false
GUEST_PUSH_WORKER_SENDING_ENABLED=false
# Dedicated PostgreSQL LOGIN role for Guest sender ONLY. Worker startup requires
# both this URL and DATABASE_URL so it can fail closed if their PostgreSQL
# usernames/principals are the same; it creates its pool ONLY from this worker
# URL and never from DATABASE_URL. Its least-privilege grants permit DB-leased
# delivery and conditional secret resolution but deny Guest API registration/
# Mark Ready mutations. Never reuse the ordinary API role/credentials here.
GUEST_PUSH_WORKER_DATABASE_URL=
# Non-secret name of an already provisioned, distinct Guest Push worker LOGIN
# role. Needed only by the separately authorized role-grant provisioning
# command, which verifies exact worker URL username/host/port/database identity
# against both ordinary DATABASE_URL and MIGRATION_DATABASE_URL BEFORE grants.
GUEST_PUSH_WORKER_ROLE=
# Public VAPID application server key is served via a narrow Guest config
# endpoint only when enrollment is enabled. Never paste private material into
# a NEXT_PUBLIC_ or EXPO_PUBLIC_ variable or client bundle.
GUEST_PUSH_VAPID_PUBLIC_KEY=
# Sender process secret-store ONLY. Inject private key and approved subject in
# the worker environment, NOT in API/Customer runtime or source control.
GUEST_PUSH_VAPID_PRIVATE_KEY=
GUEST_PUSH_VAPID_SUBJECT=
# These are fixed Accepted v1 policy bounds. Never extend READY expiry on retry.
GUEST_PUSH_POLICY_VERSION=1
GUEST_PUSH_INTENT_TTL_SECONDS=1800
GUEST_PUSH_MAX_ATTEMPTS=4
GUEST_PUSH_PROVIDER_CALL_TIMEOUT_SECONDS=10
GUEST_PUSH_LEASE_DURATION_SECONDS=30
GUEST_PUSH_RETRY_MINIMUM_SECONDS=10
GUEST_PUSH_RETRY_CAP_SECONDS=60
GUEST_PUSH_INTENT_DELIVERY_RETENTION_DAYS=7
GUEST_PUSH_TERMINAL_REGISTRATION_RETENTION_DAYS=30

# Payments
PAYMENT_PROVIDER=disabled

# Trusted origin for copied staff activation links (HTTPS in production). No path/query/fragment.
STAFF_ACTIVATION_PUBLIC_ORIGIN=https://staff.example.com

# T3 production capacity inputs (include surge and all non-API consumers).
# DATABASE_POOL_MAX=8
# DATABASE_ALLOWED_CONNECTIONS=<provider-confirmed-total>
# DATABASE_RESERVED_CONNECTIONS=<admin-maintenance-and-other-services>
# DATABASE_MAX_API_INSTANCES=<maximum-including-rollout-surge>
# DATABASE_POOL_MAX_WAITERS=128
# PostgreSQL 17 required. Fixed deadlines: acquisition 2s, lock 2s,
# Guest-only: statement 3s, idle transaction 2s, transaction 5s, operation 6s.
# General DB leases have no Guest HTTP deadline. Production requires positive
# operator-sized resource ceilings (statement < transaction; idle <= transaction).
# DATABASE_GENERAL_LOCK_MS=<finite-lock-wait-ceiling-ms>
# DATABASE_GENERAL_STATEMENT_MS=<measured-workload-statement-ceiling-ms>
# DATABASE_GENERAL_TRANSACTION_MS=<finite-transaction-and-lease-ceiling-ms>
# DATABASE_GENERAL_IDLE_TRANSACTION_MS=<finite-idle-transaction-ceiling-ms>

# T3 rollout floor. Production defaults COMPATIBILITY; T4 may select ACTIVE only
# after every API is T3 and N-1's protected window has drained. No UI dependency.
# GUEST_T3_RATE_POLICY=COMPATIBILITY
