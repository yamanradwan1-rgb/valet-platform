<section id="concept-d" class="d-workspace" aria-labelledby="d-title">
  <div class="d-titlebar">
    <div class="d-intro">
      <div class="d-breadcrumb"><span data-d-copy="section">OPERATIONS</span><span class="d-breadcrumb-rule"></span><span data-d-copy="register">RESOURCE REGISTER / CONCEPT D</span></div>
      <h1 id="d-title" data-d-copy="title">Keys &amp; Spots</h1>
      <p class="d-subtitle" data-d-copy="subtitle">Every space in its place. A structured view of where keys and vehicles belong.</p>
    </div>
    <div class="d-top-actions">
      <button type="button" id="d-zone-create" class="d-button" hidden><span data-d-copy="addZone">New parking zone · preview</span></button>
      <button type="button" id="d-create" class="d-button d-button-primary"><span class="d-button-icon" aria-hidden="true">＋</span><span data-d-copy="createKey">New key slot</span></button>
    </div>
  </div>

  <div class="d-preview-disclosure"><span class="d-preview-dot" aria-hidden="true"></span><span data-d-copy="synthetic">DESIGN PREVIEW · Synthetic resources · Changes are never saved</span></div>

  <div class="d-worktop">
    <div class="d-tabs" role="group" aria-label="Resource type" id="d-tabs">
      <button type="button" class="d-tab" data-d-kind="keys" aria-pressed="true"><span aria-hidden="true">◇</span><span data-d-copy="keys">Key Slots</span><span id="d-keys-count" class="d-tab-count">7</span></button>
      <button type="button" class="d-tab" data-d-kind="spots" aria-pressed="false"><span aria-hidden="true">▥</span><span data-d-copy="spots">Parking Spots</span><span id="d-spots-count" class="d-tab-count">7</span></button>
    </div>
    <div class="d-toolbar">
      <label class="d-search">
        <span class="d-search-glyph" aria-hidden="true">⌕</span><span class="d-sr-only" data-d-copy="searchLabel">Find resource</span>
        <input id="d-search" type="search" autocomplete="off" placeholder="Search resource, code or vehicle">
      </label>
      <label class="d-demo-field"><span data-d-copy="demoState">Preview state</span><select id="d-demo-state">
        <option value="ready">Ready</option><option value="loading">Loading</option><option value="empty">Empty</option><option value="error">Error</option>
      </select></label>
    </div>
  </div>

  <div class="d-columns">
    <section class="d-inventory" aria-labelledby="d-inventory-heading">
      <header class="d-inventory-head">
        <div><div class="d-section-tag" data-d-copy="overviewTag">GROUPED RESOURCE VIEW</div><h2 id="d-inventory-heading" data-d-copy="keyGroups">Key custody &amp; availability</h2></div>
        <p id="d-results" class="d-results" role="status" aria-live="polite"></p>
      </header>
      <div class="d-group-list" id="d-group-list"></div>
      <footer class="d-inventory-footer"><span class="d-foot-mark" aria-hidden="true">i</span><span data-d-copy="configNote">Configuration state is separate from usage. Details are illustrative.</span></footer>
    </section>
    <aside class="d-inspector" aria-label="Selected resource details" id="d-inspector">
      <div class="d-inspector-content" id="d-inspector-content"></div>
    </aside>
  </div>
  <p class="d-disclaimer" data-d-copy="truth">PROPOSED unified design. Key Slot labels, custody history and the combined operational view are illustrative, not one existing API response.</p>
  <div id="d-toast" class="d-toast" role="status" aria-live="polite" hidden></div>
  <dialog id="d-dialog" class="d-dialog" aria-labelledby="d-dialog-title">
    <div id="d-dialog-content"></div>
  </dialog>
