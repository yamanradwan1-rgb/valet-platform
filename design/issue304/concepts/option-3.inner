      <p class="c-modal-disclaimer" data-c-text="qrDemo">Illustrative QR artwork. This preview does not contain an operational scanning code.</p>
      <div class="c-modal-actions"><button class="c-quiet-action" type="button" data-c-close data-c-text="close">Close</button><button class="c-quiet-action" type="button" data-c-download data-c-text="downloadPreview">Download preview</button><button class="c-outline-action" type="button" data-c-print data-c-text="printPreview">Print preview</button></div>
    </div>
    <div data-c-add-modal hidden>
      <p class="c-modal-disclaimer" data-c-text="addDemo">Preview a draft resource. Nothing will be created or saved.</p>
      <form data-c-add-form class="c-add-form">
        <label><span data-c-text="code">Resource code</span><input type="text" name="code" maxlength="100" required autocomplete="off" placeholder="K-08"></label>
        <label><span data-c-text="label">Display label</span><input type="text" name="label" maxlength="160" autocomplete="off" placeholder="Front desk C"></label>
        <label data-c-add-zone-row hidden><span data-c-text="parkingZone">Parking zone</span><select name="zone"></select></label>
        <div class="c-draft" data-c-draft hidden role="status"></div>
        <div class="c-modal-actions"><button class="c-quiet-action" type="button" data-c-close data-c-text="cancel">Cancel</button><button class="c-outline-action" type="submit" data-c-text="previewDraft">Preview draft</button></div>
      </form>
    </div>
  </section>
</div>

<script type="application/json" data-c-copy>
{
