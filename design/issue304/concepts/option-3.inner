<section class="inspector" data-concept="c" aria-labelledby="c-page-title" data-mobile-details="false">
  <div class="c-head">
    <div class="c-heading">
      <span class="c-kicker"><span class="c-kicker-mark" aria-hidden="true"></span><span data-c-text="workspace">KEYS &amp; SPOTS / PHYSICAL RESOURCES</span></span>
      <h1 id="c-page-title" data-c-text="title">Resource inspector</h1>
      <p data-c-text="intro">One focused workspace for your key custody and parking capacity.</p>
    </div>
    <span class="c-demo-note" data-c-text="synthetic">SYNTHETIC DATA · DESIGN PREVIEW</span>
  </div>

  <section class="c-kpis" aria-label="Resource availability summary" data-c-kpis-label>
    <div class="c-kpi" data-c-kpi-family="keys" data-c-kpi="keys-active">
      <span class="c-kpi-label" data-c-text="activeKeySlots">Active key slots</span>
      <strong class="c-kpi-number" data-c-kpi-value>0</strong>
      <span class="c-kpi-context" data-c-kpi-caption="keys-configured">0 configured</span>
    </div>
    <div class="c-kpi" data-c-kpi-family="keys" data-c-kpi="keys-available">
      <span class="c-kpi-label" data-c-text="keysAvailable">Keys available</span>
      <strong class="c-kpi-number" data-c-kpi-value>0</strong>
      <span class="c-kpi-context" data-c-kpi-caption="keys-available">of 0 Active</span>
    </div>
    <div class="c-kpi" data-c-kpi-family="keys" data-c-kpi="keys-in-use">
      <span class="c-kpi-label" data-c-text="keysInUse">Keys in use</span>
      <strong class="c-kpi-number" data-c-kpi-value>0</strong>
      <span class="c-kpi-context" data-c-text="inUse">In use</span>
    </div>
    <div class="c-kpi" data-c-kpi-family="spots" data-c-kpi="spots-active">
      <span class="c-kpi-label" data-c-text="activeParkingSpots">Active parking spots</span>
      <strong class="c-kpi-number" data-c-kpi-value>0</strong>
      <span class="c-kpi-context" data-c-kpi-caption="spots-configured">0 configured</span>
    </div>
    <div class="c-kpi" data-c-kpi-family="spots" data-c-kpi="spots-available">
      <span class="c-kpi-label" data-c-text="spotsAvailable">Spots available</span>
      <strong class="c-kpi-number" data-c-kpi-value>0</strong>
      <span class="c-kpi-context" data-c-kpi-caption="spots-available">of 0 Active</span>
    </div>
    <div class="c-kpi" data-c-kpi-family="spots" data-c-kpi="spots-occupied">
      <span class="c-kpi-label" data-c-text="spotsOccupied">Spots occupied</span>
      <strong class="c-kpi-number" data-c-kpi-value>0</strong>
      <span class="c-kpi-context" data-c-text="occupied">Occupied</span>
    </div>
  </section>

  <div class="c-command-row">
    <div class="c-family-switch" role="group" aria-label="Resource family" data-c-family-label>
      <button class="c-family-button is-active" data-c-family="keys" aria-pressed="true" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="9" r="4"/><path d="M11 12l9 9m-4-4 3-3m-5 1 3-3"/></svg>
        <span data-c-text="keys">Key Slots</span><span class="c-family-count" data-c-count="keys">07</span>
      </button>
      <button class="c-family-button" data-c-family="spots" aria-pressed="false" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M9 17V7h4.25a3.25 3.25 0 0 1 0 6.5H9"/></svg>
        <span data-c-text="spots">Parking Spots</span><span class="c-family-count" data-c-count="spots">07</span>
      </button>
    </div>
    <div class="c-add-actions">
      <button type="button" class="c-add-zone" data-c-open-zone hidden><span data-c-text="addZone">Add Parking Zone</span></button>
      <button type="button" class="c-add" data-c-open-add>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <span data-c-text="addKey">Add Key Slot</span>
      </button>
    </div>
  </div>

  <div class="c-workspace">
    <section class="c-master" aria-labelledby="c-list-title">
      <div class="c-master-head">
        <div><div class="c-overline" data-c-text="collection">COLLECTION</div><h2 id="c-list-title" data-c-text="resourceList">Resource list</h2></div>
        <span class="c-list-total" data-c-list-total>7 <span data-c-text="resources">resources</span></span>
      </div>
      <div class="c-filter-row" role="group" aria-label="Filter resources" data-c-filter-label>
        <button class="c-filter is-active" type="button" data-c-filter="all" aria-pressed="true" data-c-text="all">All</button>
        <button class="c-filter" type="button" data-c-filter="busy" aria-pressed="false" data-c-text="busyFilter">In use</button>
        <button class="c-filter" type="button" data-c-filter="available" aria-pressed="false" data-c-text="available">Available</button>
        <button class="c-filter" type="button" data-c-filter="inactive" aria-pressed="false" data-c-text="inactive">Inactive</button>
      </div>
      <div class="c-list-caption"><span data-c-text="configured">CONFIGURED RESOURCES</span><span data-c-visible-count>0 / 7</span></div>
      <div class="c-master-scroll"><ul class="c-resource-list" data-c-list aria-label="Resource list"></ul><p class="c-empty" data-c-empty hidden data-c-text="none">No resources in this view.</p></div>
      <div class="c-master-foot">
        <div class="c-foot-scope"><span class="c-foot-dot" aria-hidden="true"></span><span data-c-text="scopeNote">Showing the selected location only</span></div>
        <label class="c-preview-mode"><span data-c-text="previewState">Preview state</span><select data-c-preview-state aria-label="Preview list state"><option value="normal">Sample data</option><option value="empty">Empty</option><option value="loading">Loading</option><option value="error">Error</option></select></label>
      </div>
    </section>

    <section class="c-detail" data-c-detail aria-labelledby="c-detail-heading" tabindex="-1">
      <div class="c-detail-topline">
        <button type="button" class="c-back" data-c-back>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 18 9 12l6-6"/></svg><span data-c-text="back">All resources</span>
        </button>
        <span class="c-overline" data-c-text="selected">SELECTED RESOURCE</span>
        <span class="c-position" data-c-position>01 / 07</span>
      </div>
      <div class="c-preview-wash" data-c-preview-wash hidden role="status"><span class="c-preview-wash-symbol" aria-hidden="true">⌕</span><p data-c-preview-message></p></div>
      <div class="c-detail-scroll" data-c-detail-scroll>
        <div class="c-resource-hero">
          <div class="c-resource-icon" data-c-hero-icon aria-hidden="true">K</div>
          <div class="c-hero-copy">
            <div class="c-hero-prefix" data-c-resource-type>KEY SLOT · LOC-A</div>
            <h2 id="c-detail-heading" tabindex="-1"><bdi dir="ltr" data-c-code>K-02</bdi></h2>
            <p data-c-label>Front desk B</p>
          </div>
          <button type="button" class="c-qr-action" data-c-open-qr>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M15 14h2v3h-3v4h7v-4h-2"/></svg>
            <span data-c-text="viewQR">View QR label</span>
          </button>
        </div>
        <section class="c-vehicle" aria-labelledby="c-vehicle-title">
          <div class="c-vehicle-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m5 10 2-4h10l2 4M4 10h16v7H4zM6.5 17v2m11-2v2M7 14h2m6 0h2"/></svg></div>
          <div class="c-vehicle-copy"><span class="c-stat-label" id="c-vehicle-title" data-c-text="associatedVehicle">Associated vehicle</span><strong><bdi dir="auto" data-c-vehicle>DEMO 4821</bdi></strong><span data-c-vehicle-hint>Current associated vehicle</span></div>
          <span class="c-vehicle-symbol" aria-hidden="true">↗</span>
        </section>
        <div class="c-stat-pair">
          <div class="c-stat-card"><span class="c-stat-label" data-c-text="configStatus">CONFIGURATION STATUS</span><div class="c-stat-value" data-c-status></div><p data-c-text="statusHint">Whether the resource is enabled for use</p></div>
          <div class="c-stat-card"><span class="c-stat-label" data-c-text="usageStatus">OPERATIONAL USAGE</span><div class="c-stat-value" data-c-usage></div><p data-c-usage-hint>Current operational state</p></div>
        </div>
        <div class="c-lower-grid">
          <section class="c-detail-section" aria-labelledby="c-profile-title">
            <div class="c-section-title"><span class="c-section-index">01</span><h3 id="c-profile-title" data-c-text="resourceProfile">Resource profile</h3></div>
            <dl class="c-spec-list">
              <div><dt data-c-text="code">Resource code</dt><dd><bdi class="c-mono" dir="ltr" data-c-spec-code>—</bdi></dd></div>
              <div><dt data-c-text="label">Display label</dt><dd data-c-spec-label>—</dd></div>
              <div><dt data-c-text="location">Location</dt><dd data-c-spec-location>—</dd></div>
              <div data-c-zone-row hidden><dt data-c-text="parkingZone">Parking zone</dt><dd data-c-spec-zone>—</dd></div>
            </dl>
          </section>
          <section class="c-detail-section c-timeline-section" aria-labelledby="c-timeline-title">
            <div class="c-section-title"><span class="c-section-index">02</span><h3 id="c-timeline-title" data-c-timeline-title data-c-text="custody">Key custody</h3></div>
            <p class="c-section-subtitle" data-c-timeline-intro>Recent sample checkout / return events</p>
            <ol class="c-timeline" data-c-timeline></ol>
            <p class="c-empty-events" data-c-no-events hidden data-c-text="noCustody">No recent custody activity for this slot.</p>
          </section>
        </div>
        <div class="c-detail-bottom"><span class="c-foot-dot" aria-hidden="true"></span><span data-c-text="readOnly">Design preview · all actions are local and read-only</span></div>
      </div>
    </section>
  </div>
  <p class="c-announcement c-sr-only" aria-live="polite" role="status" data-c-announce></p>
</section>

<div class="c-modal-backdrop" data-c-modal hidden>
  <section class="c-modal" role="dialog" aria-modal="true" aria-labelledby="c-modal-title" tabindex="-1">
    <div class="c-modal-heading"><div><span class="c-kicker" data-c-text="demoPreview">DESIGN PREVIEW</span><h2 id="c-modal-title" data-c-modal-title>Resource label</h2></div><button type="button" class="c-close" data-c-close aria-label="Close preview">×</button></div>
