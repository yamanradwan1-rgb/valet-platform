{
  "name": "@valet/dashboard",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @valet/contracts build && next build",
    "dev": "next dev --port 3003",
    "start": "next start --port 3003",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@valet/contracts": "workspace:*",
    "@valet/ui": "workspace:*",
    "maplibre-gl": "^5.0.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
