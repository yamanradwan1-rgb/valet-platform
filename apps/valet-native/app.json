{
  "expo": {
    "name": "VAYLET Employee",
    "slug": "vaylet-employee",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "scheme": "vaylet-employee",
    "ios": {
      "bundleIdentifier": "com.vaylet.employee",
      "supportsTablet": false
    },
    "android": {
      "package": "com.vaylet.employee"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VAYLET Employee to scan resource and handoff QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}
