{
  "name": "@valet/valet-native",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "pnpm --filter @valet/contracts build && expo start --dev-client",
    "start": "pnpm --filter @valet/contracts build && expo start --dev-client",
    "android": "node scripts/native-android-build.mjs --native-mode debug --js-mode development --dev-enabled true",
    "android:release": "node scripts/native-android-build.mjs --native-mode release --js-mode production --dev-enabled false",
    "prebuild:android": "expo prebuild --platform android --clean --no-install",
    "config:public": "expo config --type public",
    "lint": "eslint app.config.ts app src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@valet/contracts": "workspace:*",
    "@valet/employee-client": "workspace:*",
    "expo": "~57.0.19",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-camera"
        ]
      }
    }
  }
}
