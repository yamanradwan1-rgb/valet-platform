{
  "name": "@valet/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:push-worker": "node dist/staff-push-worker.js",
    "lint": "eslint src test tools --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test",
    "test:check-in-api": "vitest run test/check-in-api.integration.test.ts",
    "test:shifts": "vitest run test/shift-start.integration.test.ts test/shift-end.integration.test.ts test/shift-eligibility.integration.test.ts test/shift-api.integration.test.ts",
    "test:keys": "vitest run test/key-assignment.integration.test.ts test/key-correction.integration.test.ts test/key-eligibility-concurrency.integration.test.ts test/key-custody-api.integration.test.ts",
    "staff:provision": "tsx tools/provision-staff.ts",
    "local:bootstrap": "tsx tools/local-dev/bootstrap.ts",
    "local:status": "tsx tools/local-dev/status.ts",
    "local:smoke": "tsx tools/local-dev/smoke.ts",
    "capacity:baseline": "tsx tools/capacity/run-capacity-baseline.ts",
    "incident-recovery:rollout-check": "tsx tools/check-incident-recovery-rollout.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "^11.0.0",
    "@valet/contracts": "workspace:*",
    "argon2": "0.45.1",
    "cookie": "1.0.2",
    "dotenv": "^17.0.0",
    "google-auth-library": "10.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
