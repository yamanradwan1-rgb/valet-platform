{
  "name": "@valet/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:push-worker": "node dist/staff-push-worker.js",
    "start:guest-push-worker": "node dist/guest-push-worker.js",
    "lint": "eslint src test tools --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/test-harness/run-package-tests.mjs api",
    "test:non-postgres": "vitest run --config vitest.config.mjs --project api-non-postgres",
    "test:postgres": "node ../../scripts/test-harness/run-postgres-projects.mjs vitest.config.mjs api-postgres-standard api-postgres-compound api-postgres-race",
    "test:check-in-api": "node ../../scripts/test-harness/run-owned-tests.mjs api vitest.config.mjs test/check-in-api.integration.test.ts",
    "test:shifts": "node ../../scripts/test-harness/run-owned-tests.mjs api vitest.config.mjs test/shift-start.integration.test.ts test/shift-end.integration.test.ts test/shift-eligibility.integration.test.ts test/shift-api.integration.test.ts",
    "test:keys": "node ../../scripts/test-harness/run-owned-tests.mjs api vitest.config.mjs test/key-assignment.integration.test.ts test/key-correction.integration.test.ts test/key-eligibility-concurrency.integration.test.ts test/key-custody-api.integration.test.ts",
    "staff:provision": "tsx tools/provision-staff.ts",
    "staff:mfa-recover": "tsx tools/recover-mfa.ts",
    "staff:security-disable": "tsx tools/security-disable-staff.ts",
    "local:bootstrap": "tsx tools/local-dev/bootstrap.ts",
    "local:status": "tsx tools/local-dev/status.ts",
    "local:smoke": "tsx tools/local-dev/smoke.ts",
    "capacity:baseline": "tsx tools/capacity/run-capacity-baseline.ts",
    "incident-recovery:rollout-check": "tsx tools/check-incident-recovery-rollout.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "^11.0.0",
    "@valet/contracts": "workspace:*",
    "argon2": "0.45.1",
    "busboy": "1.6.0",
    "cookie": "1.0.2",
    "dotenv": "^17.0.0",
    "google-auth-library": "10.3.0",
    "otplib": "13.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sharp": "0.34.5",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/web-push": "3.6.4",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
