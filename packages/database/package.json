{
  "name": "@valet/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "prisma:validate": "prisma validate",
    "raw-gps:cleanup": "node scripts/raw-gps-cleanup.mjs",
    "migrate:deploy": "node scripts/run-migrate-deploy.mjs",
    "runtime:provision": "node scripts/provision-runtime-role.mjs",
    "seed": "node prisma/seed.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@prisma/client": "7.9.1",
    "dotenv": "^17.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.0.0",
    "prisma": "7.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
