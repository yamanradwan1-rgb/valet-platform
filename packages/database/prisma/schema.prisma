model AntiAbuseEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope      String
  keyHash    String   @map("key_hash")
  occurredAt DateTime @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz(3)
  state      String

  @@index([scope, keyHash, occurredAt], map: "anti_abuse_events_scope_key_hash_occurred_at_idx")
  @@index([occurredAt], map: "anti_abuse_events_occurred_at_idx")
  @@map("anti_abuse_events")
}
