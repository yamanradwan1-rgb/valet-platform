// Issue #352: immutable committed operation identity; physical custody is
// deliberately absent because changing Task ownership cannot prove key handoff.
model EmergencyTaskTakeoverOperation {
  organizationId              String   @map("organization_id") @db.Uuid
  operationId                 String   @map("operation_id") @db.Uuid
  locationId                  String   @map("location_id") @db.Uuid
  valetSessionId              String   @map("valet_session_id") @db.Uuid
  taskId                      String   @map("task_id") @db.Uuid
  actorMembershipId           String   @map("actor_membership_id") @db.Uuid
  previousAssigneeMembershipId String  @map("previous_assignee_membership_id") @db.Uuid
  newAssigneeMembershipId     String   @map("new_assignee_membership_id") @db.Uuid
  expectedTaskVersion         Int      @map("expected_task_version")
  resultTaskVersion           Int      @map("result_task_version")
  expectedSessionVersion      Int      @map("expected_session_version")
  resultSessionVersion        Int      @map("result_session_version")
  requestFingerprint          String   @map("request_fingerprint") @db.Char(64)
  occurredAt                  DateTime @map("occurred_at") @db.Timestamptz(3)
  dispatchEventId             String   @map("dispatch_event_id") @db.Uuid
  auditEventId                String   @map("audit_event_id") @db.Uuid
  endedOldTrackingSessionId   String?  @map("ended_old_tracking_session_id") @db.Uuid
  newTrackingSessionId        String?  @map("new_tracking_session_id") @db.Uuid

  location     Location @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "emergency_takeover_location_fk")
  task         Task @relation(fields: [organizationId, locationId, valetSessionId, taskId], references: [organizationId, locationId, valetSessionId, id], onDelete: Restrict, onUpdate: Restrict, map: "emergency_takeover_task_fk")
  actor        OrganizationMembership @relation("TakeoverInitiator", fields: [organizationId, actorMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "emergency_takeover_actor_fk")
  previous     OrganizationMembership @relation("TakeoverPreviousOwner", fields: [organizationId, previousAssigneeMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "emergency_takeover_previous_fk")
  replacement  OrganizationMembership @relation("TakeoverNewOwner", fields: [organizationId, newAssigneeMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "emergency_takeover_new_fk")
  dispatchEvent DispatchEvent @relation("TakeoverDispatchEvent", fields: [organizationId, dispatchEventId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "emergency_takeover_dispatch_fk")
  auditEvent AuditEvent @relation("TakeoverAuditEvent", fields: [organizationId, auditEventId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "emergency_takeover_audit_fk")
  endedOldTracker TaskTrackingSession? @relation("TakeoverOldTracker", fields: [organizationId, locationId, valetSessionId, taskId, endedOldTrackingSessionId], references: [organizationId, locationId, valetSessionId, taskId, id], onDelete: Restrict, onUpdate: Restrict, map: "emergency_takeover_old_tracker_fk")
  newTracker TaskTrackingSession? @relation("TakeoverNewTracker", fields: [organizationId, locationId, valetSessionId, taskId, newTrackingSessionId], references: [organizationId, locationId, valetSessionId, taskId, id], onDelete: Restrict, onUpdate: Restrict, map: "emergency_takeover_new_tracker_fk")

  @@id([organizationId, operationId], map: "emergency_task_takeover_operations_pkey")
  @@unique([dispatchEventId], map: "emergency_takeover_dispatch_once")
  @@unique([auditEventId], map: "emergency_takeover_audit_once")
  @@unique([organizationId, dispatchEventId], map: "emergency_takeover_org_dispatch_event_unique")
  @@unique([organizationId, auditEventId], map: "emergency_takeover_org_audit_event_unique")
  @@index([taskId, occurredAt(sort: Desc), operationId], map: "emergency_takeover_task_occurred_idx")
  @@map("emergency_task_takeover_operations")
}

