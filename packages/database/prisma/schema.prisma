  organizationId         String                    @map("organization_id") @db.Uuid
  valetSessionId         String                    @map("valet_session_id") @db.Uuid
  method                 HandoffVerificationMethod
  secretHash             String?                   @map("secret_hash")
  expiresAt              DateTime?                 @map("expires_at") @db.Timestamptz(3)
  attemptCount           Int                       @default(0) @map("attempt_count")
  maxAttempts            Int                       @map("max_attempts")
  verifiedAt             DateTime?                 @map("verified_at") @db.Timestamptz(3)
  verifiedByMembershipId String?                   @map("verified_by_membership_id") @db.Uuid
  consumedAt             DateTime?                 @map("consumed_at") @db.Timestamptz(3)
  overrideReason         String?                   @map("override_reason")
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

