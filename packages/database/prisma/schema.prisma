model Payment {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  locationId             String                  @map("location_id") @db.Uuid
  valetSessionId         String                  @map("valet_session_id") @db.Uuid
  servicePayer           PaymentServicePayer     @map("service_payer")
  collectionMethod       PaymentCollectionMethod @map("collection_method")
  currency               String
  serviceAmount          Decimal                 @map("service_amount") @db.Decimal(14, 3)
  tipAmount              Decimal                 @map("tip_amount") @db.Decimal(14, 3)
  amountDue              Decimal                 @map("amount_due") @db.Decimal(14, 3)
  amountPaid             Decimal                 @map("amount_paid") @db.Decimal(14, 3)
  status                 PaymentStatus
  creationIdempotencyKey String                  @map("creation_idempotency_key")
  provider               String?
  providerReference      String?                 @map("provider_reference")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  paidAt                 DateTime?               @map("paid_at") @db.Timestamptz(3)

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "payments_organization_id_fkey")
  location       Location               @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, map: "payments_org_location_id_fkey")
  valetSession   ValetSession           @relation(fields: [organizationId, locationId, valetSessionId], references: [organizationId, locationId, id], onDelete: Restrict, map: "payments_org_location_valet_session_id_fkey")
  validations    Validation[]
  cashEntries    CashEntry[]
  providerEvents PaymentProviderEvent[]
  refunds        Refund[]

  @@unique([organizationId, valetSessionId], map: "payments_organization_id_valet_session_id_key")
  @@unique([organizationId, creationIdempotencyKey], map: "payments_organization_id_creation_idempotency_key")
  @@unique([organizationId, provider, providerReference], map: "payments_organization_id_provider_provider_reference_key")
  @@unique([organizationId, id], map: "payments_organization_id_id_key")
  @@map("payments")
}

model Validation {
  id                     String         @id @default(uuid()) @db.Uuid
  organizationId         String         @map("organization_id") @db.Uuid
  paymentId              String         @map("payment_id") @db.Uuid
  mode                   ValidationMode
  amount                 Decimal        @db.Decimal(14, 3)
  isCurrent              Boolean        @map("is_current")
  supersedesValidationId String?        @map("supersedes_validation_id") @db.Uuid
  appliedByMembershipId  String         @map("applied_by_membership_id") @db.Uuid
  appliedAt              DateTime       @map("applied_at") @db.Timestamptz(3)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "validations_organization_id_fkey")
  payment              Payment                @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: Restrict, map: "validations_org_payment_id_fkey")
  supersedesValidation Validation?            @relation("ValidationSupersession", fields: [organizationId, paymentId, supersedesValidationId], references: [organizationId, paymentId, id], onDelete: Restrict, map: "validations_org_payment_supersedes_id_fkey")
  supersededBy         Validation[]           @relation("ValidationSupersession")
  appliedByMembership  OrganizationMembership @relation(fields: [organizationId, appliedByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "validations_org_applied_by_membership_id_fkey")

  @@unique([organizationId, paymentId, id], map: "validations_organization_id_payment_id_id_key")
  @@map("validations")
}

model CashEntry {
  id                               String        @id @default(uuid()) @db.Uuid
  organizationId                   String        @map("organization_id") @db.Uuid
  paymentId                        String        @map("payment_id") @db.Uuid
  entryType                        CashEntryType @map("entry_type")
  amount                           Decimal       @db.Decimal(14, 3)
  receivedOrAdjustedByMembershipId String        @map("received_or_adjusted_by_membership_id") @db.Uuid
  reason                           String?
  submissionIdempotencyKey         String        @map("submission_idempotency_key")
  occurredAt                       DateTime      @map("occurred_at") @db.Timestamptz(3)
  createdAt                        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  organization                   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "cash_entries_organization_id_fkey")
  payment                        Payment                @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: Restrict, map: "cash_entries_org_payment_id_fkey")
  receivedOrAdjustedByMembership OrganizationMembership @relation(fields: [organizationId, receivedOrAdjustedByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "cash_entries_org_received_or_adjusted_by_membership_id_fkey")

  @@unique([organizationId, submissionIdempotencyKey], map: "cash_entries_organization_id_submission_idempotency_key")
  @@map("cash_entries")
}

model PaymentProviderEvent {
  id                String                               @id @default(uuid()) @db.Uuid
  organizationId    String                               @map("organization_id") @db.Uuid
  paymentId         String                               @map("payment_id") @db.Uuid
  refundId          String?                              @map("refund_id") @db.Uuid
  provider          String
  providerEventId   String                               @map("provider_event_id")
  providerReference String?                              @map("provider_reference")
  processingStatus  PaymentProviderEventProcessingStatus @map("processing_status")
  receivedAt        DateTime                             @map("received_at") @db.Timestamptz(3)
  processedAt       DateTime                             @map("processed_at") @db.Timestamptz(3)
  safeResultCode    String?                              @map("safe_result_code")
  createdAt         DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "payment_provider_events_organization_id_fkey")
  payment      Payment      @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: Restrict, map: "payment_provider_events_org_payment_id_fkey")
  refund       Refund?      @relation(fields: [organizationId, paymentId, refundId], references: [organizationId, paymentId, id], onDelete: Restrict, map: "payment_provider_events_org_payment_refund_id_fkey")

  @@unique([organizationId, provider, providerEventId], map: "payment_provider_events_org_provider_event_id_key")
  @@map("payment_provider_events")
}

model Refund {
  id                       String       @id @default(uuid()) @db.Uuid
  organizationId           String       @map("organization_id") @db.Uuid
  paymentId                String       @map("payment_id") @db.Uuid
  amount                   Decimal      @db.Decimal(14, 3)
  reason                   String
  status                   RefundStatus
  authorizedByMembershipId String       @map("authorized_by_membership_id") @db.Uuid
  idempotencyKey           String       @map("idempotency_key")
  provider                 String?
  providerReference        String?      @map("provider_reference")
  requestedAt              DateTime     @map("requested_at") @db.Timestamptz(3)
  completedAt              DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "refunds_organization_id_fkey")
  payment                Payment                @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: Restrict, map: "refunds_org_payment_id_fkey")
  authorizedByMembership OrganizationMembership @relation(fields: [organizationId, authorizedByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "refunds_org_authorized_by_membership_id_fkey")
  providerEvents         PaymentProviderEvent[]

  @@unique([organizationId, idempotencyKey], map: "refunds_organization_id_idempotency_key")
  @@unique([organizationId, provider, providerReference], map: "refunds_organization_id_provider_provider_reference_key")
  @@unique([organizationId, paymentId, id], map: "refunds_organization_id_payment_id_id_key")
  @@map("refunds")
}

model Incident {
  id                     String           @id @default(uuid()) @db.Uuid
  organizationId         String           @map("organization_id") @db.Uuid
  locationId             String           @map("location_id") @db.Uuid
  valetSessionId         String           @map("valet_session_id") @db.Uuid
  status                 IncidentStatus
  severity               IncidentSeverity
  type                   String
  description            String
  reportedByMembershipId String           @map("reported_by_membership_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt             DateTime?        @map("resolved_at") @db.Timestamptz(3)
  resolvedByMembershipId String?          @map("resolved_by_membership_id") @db.Uuid
  resolutionNotes        String?          @map("resolution_notes")

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "incidents_organization_id_fkey")
  location             Location                @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, map: "incidents_org_location_id_fkey")
  valetSession         ValetSession            @relation(fields: [organizationId, locationId, valetSessionId], references: [organizationId, locationId, id], onDelete: Restrict, map: "incidents_org_location_valet_session_id_fkey")
  reportedByMembership OrganizationMembership  @relation("IncidentReportedBy", fields: [organizationId, reportedByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "incidents_org_reported_by_membership_id_fkey")
  resolvedByMembership OrganizationMembership? @relation("IncidentResolvedBy", fields: [organizationId, resolvedByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "incidents_org_resolved_by_membership_id_fkey")

  @@index([locationId, status], map: "incidents_location_id_status_idx")
  @@map("incidents")
}

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  valetSessionId    String?             @map("valet_session_id") @db.Uuid
  channel           NotificationChannel
  recipient         String
  templateKey       String              @map("template_key")
  status            NotificationStatus  @default(PENDING)
  providerReference String?             @map("provider_reference")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  failedAt          DateTime?           @map("failed_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "notifications_organization_id_fkey")
  valetSession ValetSession? @relation(fields: [organizationId, valetSessionId], references: [organizationId, id], onDelete: Restrict, map: "notifications_org_valet_session_id_fkey")

  @@map("notifications")
}

model AuditEvent {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  locationId        String   @map("location_id") @db.Uuid
  valetSessionId    String?  @map("valet_session_id") @db.Uuid
  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  eventType         String   @map("event_type")
  entityType        String   @map("entity_type")
  entityId          String   @map("entity_id") @db.Uuid
  metadataJson      Json     @map("metadata_json") @db.JsonB
  idempotencyKey    String?  @map("idempotency_key")
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "audit_events_organization_id_fkey")
  location        Location                @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, map: "audit_events_org_location_id_fkey")
  valetSession    ValetSession?           @relation(fields: [organizationId, locationId, valetSessionId], references: [organizationId, locationId, id], onDelete: Restrict, map: "audit_events_org_location_valet_session_id_fkey")
  actorMembership OrganizationMembership? @relation(fields: [organizationId, actorMembershipId], references: [organizationId, id], onDelete: Restrict, map: "audit_events_org_actor_membership_id_fkey")

