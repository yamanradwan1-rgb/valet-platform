generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE

  @@map("organization_status")
}

enum LocationStatus {
  ACTIVE
  INACTIVE

  @@map("location_status")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum MembershipRole {
  ORG_ADMIN
  LOCATION_MANAGER
  VALET_SUPERVISOR
  VALET_EMPLOYEE

  @@map("membership_role")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE

  @@map("membership_status")
}

enum ShiftStatus {
  ACTIVE
  ENDED

  @@map("shift_status")
}

enum ParkingSpotStatus {
  ACTIVE
  INACTIVE

  @@map("parking_spot_status")
}

enum KeySlotStatus {
  ACTIVE
  INACTIVE

  @@map("key_slot_status")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  status    OrganizationStatus @default(ACTIVE)
  timezone  String
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  locations                Location[]
  memberships              OrganizationMembership[]
  membershipLocationAccess MembershipLocationAccess[]
  shifts                   Shift[]
  customers                Customer[]
  vehicles                 Vehicle[]
  parkingSpots             ParkingSpot[]
  keySlots                 KeySlot[]

  @@map("organizations")
}

model Location {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  code           String
  addressText    String         @map("address_text")
  timezone       String
  currency       String
  status         LocationStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization             Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membershipLocationAccess MembershipLocationAccess[]
  shifts                   Shift[]
  parkingSpots             ParkingSpot[]
  keySlots                 KeySlot[]

  @@unique([organizationId, code], map: "locations_organization_id_code_key")
  @@unique([organizationId, id], map: "locations_organization_id_id_key")
  @@map("locations")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique(map: "users_email_key")
  phone        String?
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)

  memberships OrganizationMembership[]

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization             Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                     User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  membershipLocationAccess MembershipLocationAccess[]
  shifts                   Shift[]

  @@unique([organizationId, userId], map: "organization_memberships_organization_id_user_id_key")
  @@unique([organizationId, id], map: "organization_memberships_organization_id_id_key")
  @@map("organization_memberships")
}

model MembershipLocationAccess {
  organizationId String   @map("organization_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership   OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  location     Location               @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@id([membershipId, locationId], map: "membership_location_access_pkey")
  @@map("membership_location_access")
}

model Shift {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  locationId     String      @map("location_id") @db.Uuid
  membershipId   String      @map("membership_id") @db.Uuid
  status         ShiftStatus @default(ACTIVE)
  startedAt      DateTime    @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?   @map("ended_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location               @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  membership   OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)

  @@index([locationId, status], map: "shifts_location_id_status_idx")
  @@map("shifts")
}

model Customer {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  phoneNormalized String   @map("phone_normalized")
  displayName     String?  @map("display_name")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("customers")
}

model Vehicle {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  plateCountry          String?  @map("plate_country")
  plateNumberRaw        String?  @map("plate_number_raw")
  plateNumberNormalized String?  @map("plate_number_normalized")
  temporaryDescriptor   String?  @map("temporary_descriptor")
  make                  String?
  model                 String?
  color                 String?
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("vehicles")
}

model ParkingSpot {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  locationId     String            @map("location_id") @db.Uuid
  code           String
  label          String
  status         ParkingSpotStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([locationId, code], map: "parking_spots_location_id_code_key")
  @@map("parking_spots")
}

model KeySlot {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  locationId     String        @map("location_id") @db.Uuid
  code           String
  status         KeySlotStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([locationId, code], map: "key_slots_location_id_code_key")
  @@map("key_slots")
}
