generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE

  @@map("organization_status")
}

enum LocationStatus {
  ACTIVE
  INACTIVE

  @@map("location_status")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum MembershipRole {
  ORG_ADMIN
  LOCATION_MANAGER
  VALET_SUPERVISOR
  VALET_EMPLOYEE

  @@map("membership_role")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE

  @@map("membership_status")
}

enum ShiftStatus {
  ACTIVE
  ENDED

  @@map("shift_status")
}

enum ParkingSpotStatus {
  ACTIVE
  INACTIVE

  @@map("parking_spot_status")
}

enum KeySlotStatus {
  ACTIVE
  INACTIVE

  @@map("key_slot_status")
}

enum ValetSessionState {
  CHECKING_IN
  AWAITING_PARKING
  PARKING
  PARKED
  REQUESTED
  RETRIEVING
  READY
  HANDOFF_PENDING
  COMPLETED

  @@map("valet_session_state")
}

enum ConditionEvidenceContext {
  CHECK_IN

  @@map("condition_evidence_context")
}

enum VehiclePhotoPurpose {
  CHECK_IN_CONDITION

  @@map("vehicle_photo_purpose")
}

enum RetrievalRequesterType {
  CUSTOMER
  STAFF

  @@map("retrieval_requester_type")
}

enum RetrievalRequestStatus {
  OPEN
  ACCEPTED
  CANCELLED
  COMPLETED

  @@map("retrieval_request_status")
}

enum HandoffVerificationMethod {
  PICKUP_CODE
  DYNAMIC_QR
  SUPERVISOR_OVERRIDE

  @@map("handoff_verification_method")
}

enum PaymentServicePayer {
  CUSTOMER
  VENUE

  @@map("payment_service_payer")
}

enum PaymentCollectionMethod {
  NONE
  CASH
  DIGITAL

  @@map("payment_collection_method")
}

enum PaymentStatus {
  NOT_REQUIRED
  UNPAID
  PENDING
  PAID
  FAILED

  @@map("payment_status")
}

enum ValidationMode {
  NONE
  FULL
  PARTIAL

  @@map("validation_mode")
}

enum CashEntryType {
  RECEIPT
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE

  @@map("cash_entry_type")
}

enum PaymentProviderEventProcessingStatus {
  PROCESSED
  IGNORED

  @@map("payment_provider_event_processing_status")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("refund_status")
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED

  @@map("incident_status")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("incident_severity")
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@map("notification_status")
}

model Organization {
  id                    String             @id @default(uuid()) @db.Uuid
  name                  String
  status                OrganizationStatus @default(ACTIVE)
  timezone              String
  checkInPhotosRequired Boolean            @default(false) @map("check_in_photos_required")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  locations                Location[]
  memberships              OrganizationMembership[]
  membershipLocationAccess MembershipLocationAccess[]
  shifts                   Shift[]
  customers                Customer[]
  vehicles                 Vehicle[]
  parkingSpots             ParkingSpot[]
  keySlots                 KeySlot[]
  valetSessions            ValetSession[]
  retrievalRequests        RetrievalRequest[]
  handoffVerifications     HandoffVerification[]
  auditEvents              AuditEvent[]
  payments                 Payment[]
  validations              Validation[]
  cashEntries              CashEntry[]
  paymentProviderEvents    PaymentProviderEvent[]
  refunds                  Refund[]
  incidents                Incident[]
  notifications            Notification[]
  conditionNotes           ConditionNote[]
  vehiclePhotos            VehiclePhoto[]
  intakeOperations         IntakeOperation[]

  @@map("organizations")
}

model Location {
  id                            String         @id @default(uuid()) @db.Uuid
  organizationId                String         @map("organization_id") @db.Uuid
  name                          String
  code                          String
  addressText                   String         @map("address_text")
  timezone                      String
  currency                      String
  status                        LocationStatus @default(ACTIVE)
  checkInPhotosRequiredOverride Boolean?       @map("check_in_photos_required_override")
  createdAt                     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization             Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membershipLocationAccess MembershipLocationAccess[]
  shifts                   Shift[]
  parkingSpots             ParkingSpot[]
  keySlots                 KeySlot[]
  valetSessions            ValetSession[]
  auditEvents              AuditEvent[]
  payments                 Payment[]
  incidents                Incident[]
  conditionNotes           ConditionNote[]
  vehiclePhotos            VehiclePhoto[]
  intakeOperations         IntakeOperation[]

  @@unique([organizationId, code], map: "locations_organization_id_code_key")
  @@unique([organizationId, id], map: "locations_organization_id_id_key")
  @@map("locations")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique(map: "users_email_key")
  phone        String?
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)

  memberships       OrganizationMembership[]
  staffAuthSessions StaffAuthSession[]

  @@map("users")
}

model StaffAuthSession {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  currentAccessTokenHash String    @unique(map: "staff_auth_sessions_current_access_token_hash_key") @map("current_access_token_hash")
  accessExpiresAt        DateTime  @map("access_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt      DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastRotatedAt          DateTime  @map("last_rotated_at") @db.Timestamptz(3)

  user               User                     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refreshCredentials StaffRefreshCredential[]

  @@index([userId, revokedAt, absoluteExpiresAt], map: "staff_auth_sessions_user_id_status_idx")
  @@map("staff_auth_sessions")
}

model StaffRefreshCredential {
  id                     String    @id @default(uuid()) @db.Uuid
  sessionId              String    @map("session_id") @db.Uuid
  tokenHash              String    @unique(map: "staff_refresh_credentials_token_hash_key") @map("token_hash")
  generation             Int
  createdAt              DateTime  @map("created_at") @db.Timestamptz(3)
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt             DateTime? @map("consumed_at") @db.Timestamptz(3)
  replacedByCredentialId String?   @map("replaced_by_credential_id") @db.Uuid

  session      StaffAuthSession         @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replaces     StaffRefreshCredential?  @relation("StaffRefreshReplacement", fields: [sessionId, replacedByCredentialId], references: [sessionId, id], onDelete: Restrict, onUpdate: Restrict)
  replacedFrom StaffRefreshCredential[] @relation("StaffRefreshReplacement")

  @@unique([sessionId, generation], map: "staff_refresh_credentials_session_id_generation_key")
  @@unique([sessionId, id], map: "staff_refresh_credentials_session_id_id_key")
  @@map("staff_refresh_credentials")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization             Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                     User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  membershipLocationAccess MembershipLocationAccess[]
  shifts                   Shift[]
  checkedInValetSessions   ValetSession[]             @relation("ValetSessionCheckedInBy")
  assignedValetSessions    ValetSession[]             @relation("ValetSessionCurrentAssignee")
  completedValetSessions   ValetSession[]             @relation("ValetSessionCompletedBy")
  retrievalRequests        RetrievalRequest[]
  verifiedHandoffs         HandoffVerification[]
  auditEvents              AuditEvent[]
  appliedValidations       Validation[]
  cashEntries              CashEntry[]
  authorizedRefunds        Refund[]
  reportedIncidents        Incident[]                 @relation("IncidentReportedBy")
  resolvedIncidents        Incident[]                 @relation("IncidentResolvedBy")
  recordedConditionNotes   ConditionNote[]
  capturedVehiclePhotos    VehiclePhoto[]
  completedConditionChecks ValetSession[]             @relation("ValetSessionCheckInConditionCompletedBy")

  @@unique([organizationId, userId], map: "organization_memberships_organization_id_user_id_key")
  @@unique([organizationId, id], map: "organization_memberships_organization_id_id_key")
  @@map("organization_memberships")
}

model MembershipLocationAccess {
  organizationId String   @map("organization_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership   OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  location     Location               @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@id([membershipId, locationId], map: "membership_location_access_pkey")
  @@map("membership_location_access")
}

model Shift {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  locationId     String      @map("location_id") @db.Uuid
  membershipId   String      @map("membership_id") @db.Uuid
  status         ShiftStatus @default(ACTIVE)
  startedAt      DateTime    @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?   @map("ended_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location               @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  membership   OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)

  @@index([locationId, status], map: "shifts_location_id_status_idx")
  @@map("shifts")
}

model Customer {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  phoneNormalized String   @map("phone_normalized")
  displayName     String?  @map("display_name")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  valetSessions     ValetSession[]
  retrievalRequests RetrievalRequest[]

  @@unique([organizationId, id], map: "customers_organization_id_id_key")
  @@map("customers")
}

model Vehicle {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  plateCountry          String?  @map("plate_country")
  plateNumberRaw        String?  @map("plate_number_raw")
  plateNumberNormalized String?  @map("plate_number_normalized")
  temporaryDescriptor   String?  @map("temporary_descriptor")
  make                  String?
  model                 String?
  color                 String?
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  valetSessions ValetSession[]

  @@unique([organizationId, id], map: "vehicles_organization_id_id_key")
  @@map("vehicles")
}

model ParkingSpot {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  locationId     String            @map("location_id") @db.Uuid
  code           String
  label          String
  status         ParkingSpotStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location      Location       @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  valetSessions ValetSession[]

  @@unique([locationId, code], map: "parking_spots_location_id_code_key")
  @@unique([organizationId, locationId, id], map: "parking_spots_organization_id_location_id_id_key")
  @@map("parking_spots")
}

model KeySlot {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  locationId     String        @map("location_id") @db.Uuid
  code           String
  status         KeySlotStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location      Location       @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  valetSessions ValetSession[]

  @@unique([locationId, code], map: "key_slots_location_id_code_key")
  @@unique([organizationId, locationId, id], map: "key_slots_organization_id_location_id_id_key")
  @@map("key_slots")
}

model ValetSession {
  id                                      String            @id @default(uuid()) @db.Uuid
  customerAccessTokenHash                 String            @unique(map: "valet_sessions_customer_access_token_hash_key") @map("customer_access_token_hash")
  customerAccessExpiresAt                 DateTime          @map("customer_access_expires_at") @db.Timestamptz(3)
  customerAccessRevokedAt                 DateTime?         @map("customer_access_revoked_at") @db.Timestamptz(3)
  organizationId                          String            @map("organization_id") @db.Uuid
  locationId                              String            @map("location_id") @db.Uuid
  vehicleId                               String            @map("vehicle_id") @db.Uuid
  customerId                              String?           @map("customer_id") @db.Uuid
  state                                   ValetSessionState
  parkingSpotId                           String?           @map("parking_spot_id") @db.Uuid
  keySlotId                               String?           @map("key_slot_id") @db.Uuid
  currentAssigneeMembershipId             String?           @map("current_assignee_membership_id") @db.Uuid
  checkedInByMembershipId                 String            @map("checked_in_by_membership_id") @db.Uuid
  checkInConditionCompletedByMembershipId String?           @map("check_in_condition_completed_by_membership_id") @db.Uuid
  completedByMembershipId                 String?           @map("completed_by_membership_id") @db.Uuid
  createdAt                               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  checkInConditionCompletedAt             DateTime?         @map("check_in_condition_completed_at") @db.Timestamptz(3)
  checkingInCompletedAt                   DateTime?         @map("checking_in_completed_at") @db.Timestamptz(3)
  parkingStartedAt                        DateTime?         @map("parking_started_at") @db.Timestamptz(3)
  parkedAt                                DateTime?         @map("parked_at") @db.Timestamptz(3)
  retrievalRequestedAt                    DateTime?         @map("retrieval_requested_at") @db.Timestamptz(3)
  retrievalStartedAt                      DateTime?         @map("retrieval_started_at") @db.Timestamptz(3)
  readyAt                                 DateTime?         @map("ready_at") @db.Timestamptz(3)
  handoffPendingAt                        DateTime?         @map("handoff_pending_at") @db.Timestamptz(3)
  completedAt                             DateTime?         @map("completed_at") @db.Timestamptz(3)
  version                                 Int               @default(1)
  updatedAt                               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization                Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "valet_sessions_organization_id_fkey")
  location                    Location                @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, map: "valet_sessions_org_location_id_fkey")
  vehicle                     Vehicle                 @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Restrict, map: "valet_sessions_org_vehicle_id_fkey")
  customer                    Customer?               @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, map: "valet_sessions_org_customer_id_fkey")
  parkingSpot                 ParkingSpot?            @relation(fields: [organizationId, locationId, parkingSpotId], references: [organizationId, locationId, id], onDelete: Restrict, map: "valet_sessions_org_location_parking_spot_id_fkey")
  keySlot                     KeySlot?                @relation(fields: [organizationId, locationId, keySlotId], references: [organizationId, locationId, id], onDelete: Restrict, map: "valet_sessions_org_location_key_slot_id_fkey")
  currentAssignee             OrganizationMembership? @relation("ValetSessionCurrentAssignee", fields: [organizationId, currentAssigneeMembershipId], references: [organizationId, id], onDelete: Restrict, map: "valet_sessions_org_current_assignee_id_fkey")
  checkedInBy                 OrganizationMembership  @relation("ValetSessionCheckedInBy", fields: [organizationId, checkedInByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "valet_sessions_org_checked_in_by_id_fkey")
  checkInConditionCompletedBy OrganizationMembership? @relation("ValetSessionCheckInConditionCompletedBy", fields: [organizationId, checkInConditionCompletedByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "valet_sessions_org_condition_completed_by_id_fkey")
  completedBy                 OrganizationMembership? @relation("ValetSessionCompletedBy", fields: [organizationId, completedByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "valet_sessions_org_completed_by_id_fkey")
  auditEvents                 AuditEvent[]
  retrievalRequests           RetrievalRequest[]
  handoffVerifications        HandoffVerification[]
  payments                    Payment[]
  incidents                   Incident[]
  notifications               Notification[]
  conditionNotes              ConditionNote[]
  vehiclePhotos               VehiclePhoto[]
  intakeOperations            IntakeOperation[]

  @@unique([organizationId, id], map: "valet_sessions_organization_id_id_key")
  @@unique([organizationId, locationId, id], map: "valet_sessions_organization_id_location_id_id_key")
  @@index([locationId, state], map: "valet_sessions_location_id_state_idx")
  @@index([vehicleId, createdAt(sort: Desc)], map: "valet_sessions_vehicle_id_created_at_idx")
  @@index([locationId, retrievalRequestedAt], map: "valet_sessions_location_id_retrieval_requested_at_idx")
  @@map("valet_sessions")
}

model IntakeOperation {
  organizationId     String   @map("organization_id") @db.Uuid
  operationKey       String   @map("operation_key")
  requestFingerprint String   @map("request_fingerprint")
  locationId         String   @map("location_id") @db.Uuid
  valetSessionId     String   @unique(map: "intake_operations_valet_session_id_key") @map("valet_session_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "intake_operations_organization_id_fkey")
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "intake_operations_org_location_id_fkey")
  valetSession ValetSession @relation(fields: [organizationId, locationId, valetSessionId], references: [organizationId, locationId, id], onDelete: Restrict, onUpdate: Restrict, map: "intake_operations_org_location_session_id_fkey")

  @@id([organizationId, operationKey], map: "intake_operations_pkey")
  @@map("intake_operations")
}

model ConditionNote {
  id                        String                   @id @default(uuid()) @db.Uuid
  organizationId            String                   @map("organization_id") @db.Uuid
  locationId                String                   @map("location_id") @db.Uuid
  valetSessionId            String                   @map("valet_session_id") @db.Uuid
  context                   ConditionEvidenceContext
  content                   String
  supersedesConditionNoteId String?                  @map("supersedes_condition_note_id") @db.Uuid
  recordedByMembershipId    String                   @map("recorded_by_membership_id") @db.Uuid
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "condition_notes_organization_id_fkey")
  location                Location               @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "condition_notes_org_location_id_fkey")
  valetSession            ValetSession           @relation(fields: [organizationId, locationId, valetSessionId], references: [organizationId, locationId, id], onDelete: Restrict, onUpdate: Restrict, map: "condition_notes_org_location_session_id_fkey")
  recordedByMembership    OrganizationMembership @relation(fields: [organizationId, recordedByMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "condition_notes_org_recorded_by_membership_id_fkey")
  supersedesConditionNote ConditionNote?         @relation("ConditionNoteSupersession", fields: [organizationId, locationId, valetSessionId, context, supersedesConditionNoteId], references: [organizationId, locationId, valetSessionId, context, id], onDelete: Restrict, onUpdate: Restrict, map: "condition_notes_scope_supersedes_id_fkey")
  supersededBy            ConditionNote[]        @relation("ConditionNoteSupersession")

  @@unique([organizationId, locationId, valetSessionId, context, id], map: "condition_notes_scope_context_id_key")
  @@index([valetSessionId, createdAt], map: "condition_notes_valet_session_id_created_at_idx")
  @@map("condition_notes")
}

model VehiclePhoto {
  id                     String              @id @default(uuid()) @db.Uuid
  organizationId         String              @map("organization_id") @db.Uuid
  locationId             String              @map("location_id") @db.Uuid
  valetSessionId         String              @map("valet_session_id") @db.Uuid
  capturedByMembershipId String              @map("captured_by_membership_id") @db.Uuid
  purpose                VehiclePhotoPurpose
  storageObjectKey       String              @unique(map: "vehicle_photos_storage_object_key_key") @map("storage_object_key")
  contentType            String              @map("content_type")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vehicle_photos_organization_id_fkey")
  location             Location               @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "vehicle_photos_org_location_id_fkey")
  valetSession         ValetSession           @relation(fields: [organizationId, locationId, valetSessionId], references: [organizationId, locationId, id], onDelete: Restrict, onUpdate: Restrict, map: "vehicle_photos_org_location_session_id_fkey")
  capturedByMembership OrganizationMembership @relation(fields: [organizationId, capturedByMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "vehicle_photos_org_captured_by_membership_id_fkey")

  @@index([valetSessionId, purpose, createdAt], map: "vehicle_photos_valet_session_id_purpose_created_at_idx")
  @@map("vehicle_photos")
}

model RetrievalRequest {
  id                      String                 @id @default(uuid()) @db.Uuid
  organizationId          String                 @map("organization_id") @db.Uuid
  valetSessionId          String                 @map("valet_session_id") @db.Uuid
  requestedByType         RetrievalRequesterType @map("requested_by_type")
  requestedByCustomerId   String?                @map("requested_by_customer_id") @db.Uuid
  requestedByMembershipId String?                @map("requested_by_membership_id") @db.Uuid
  status                  RetrievalRequestStatus
  requestedAt             DateTime               @map("requested_at") @db.Timestamptz(3)
  cancelledAt             DateTime?              @map("cancelled_at") @db.Timestamptz(3)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "retrieval_requests_organization_id_fkey")
  valetSession          ValetSession            @relation(fields: [organizationId, valetSessionId], references: [organizationId, id], onDelete: Restrict, map: "retrieval_requests_org_valet_session_id_fkey")
  requestedByCustomer   Customer?               @relation(fields: [organizationId, requestedByCustomerId], references: [organizationId, id], onDelete: Restrict, map: "retrieval_requests_org_requested_by_customer_id_fkey")
  requestedByMembership OrganizationMembership? @relation(fields: [organizationId, requestedByMembershipId], references: [organizationId, id], onDelete: Restrict, map: "retrieval_requests_org_requested_by_membership_id_fkey")

  @@map("retrieval_requests")
}

model HandoffVerification {
