model Organization {
  shiftPresenceManagementResults ShiftPresenceManagementResult[]
  id                          String                      @id @default(uuid()) @db.Uuid
  name                        String
  status                      OrganizationStatus          @default(ACTIVE)
  timezone                    String
  checkInPhotosRequired       Boolean                     @default(false) @map("check_in_photos_required")
  handoffStandardMethodPolicy HandoffStandardMethodPolicy @default(EITHER) @map("handoff_standard_method_policy")
  trackingEnabled             Boolean                     @default(false) @map("tracking_enabled")
  rawGpsRetentionDays         Int                         @default(30) @map("raw_gps_retention_days")
  valetServiceFee             Decimal                     @default(0) @map("valet_service_fee") @db.Decimal(14, 3)
  paymentServicePayer         PaymentServicePayer         @default(CUSTOMER) @map("payment_service_payer")
  paymentMethodsPolicy        PaymentMethodsPolicy        @default(CASH_ONLY) @map("payment_methods_policy")
  tipsEnabled                 Boolean                     @default(false) @map("tips_enabled")
  validationEnabled           Boolean                     @default(false) @map("validation_enabled")
  releaseRequiresPayment      Boolean                     @default(false) @map("release_requires_payment")
  languageDefault             ManagementLanguage          @default(EN) @map("language_default")
  ocrAssistEnabled            Boolean                     @default(true) @map("ocr_assist_enabled")
  parkingSpotRequired         Boolean                     @default(true) @map("parking_spot_required")
  employeeRetrievalRequestedNotificationEnabled Boolean  @default(true) @map("employee_retrieval_requested_notification_enabled")
  guestVehicleReadyNotificationEnabled Boolean           @default(true) @map("guest_vehicle_ready_notification_enabled")
  brandPrimaryColor           String                      @default("#176BFF") @map("brand_primary_color")
  createdAt                   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  locations                   Location[]
  memberships                 OrganizationMembership[]
  membershipLocationAccess    MembershipLocationAccess[]
  shifts                      Shift[]
  shiftForceEndClosures        ShiftForceEndClosure[]
  customers                   Customer[]
  vehicles                    Vehicle[]
  parkingZones                ParkingZone[]
  parkingSpots                ParkingSpot[]
  keySlots                    KeySlot[]
  keyCustodyEvents            KeyCustodyEvent[]
  tasks                       Task[]
  subscription                OrganizationSubscription?
  valetSessions               ValetSession[]
  retrievalRequests           RetrievalRequest[]
  handoffVerifications        HandoffVerification[]
  auditEvents                 AuditEvent[]
  payments                    Payment[]
  validations                 Validation[]
  cashEntries                 CashEntry[]
  paymentProviderEvents       PaymentProviderEvent[]
  paymentCollectionOperations PaymentCollectionOperation[]
  refunds                     Refund[]
  incidents                   Incident[]
  incidentRecoveryIntents     IncidentRecoveryIntent[]
  notifications               Notification[]
  conditionNotes              ConditionNote[]
  vehiclePhotos               VehiclePhoto[]
  conditionPhotoUploadOperations ConditionPhotoUploadOperation[]
  conditionPhotoUploadAttempts ConditionPhotoUploadAttempt[]
  vehiclePhotoVerifications VehiclePhotoVerification[]
  vehiclePhotoAvailability VehiclePhotoAvailability[]
  intakeOperations            IntakeOperation[]
  locationMapPoints           LocationMapPoint[]
  locationMapAreas            LocationMapArea[]
  taskTrackingSessions        TaskTrackingSession[]
  rawGpsSamples               RawGpsSample[]
  geofenceEvents              GeofenceEvent[]
  staffPushIntents            StaffPushIntent[]
  staffPushDeliveries         StaffPushDelivery[]
  guestPushRegistrations      GuestPushRegistration[]
  guestPushIntents            GuestPushIntent[]
  guestPushDeliveries         GuestPushDelivery[]
  outboundProviderBindings    OutboundProviderBinding[]
  outboundMessagingPolicies   OutboundMessagingPolicy[]
  outboundMessagingPermissions OutboundMessagingPermission[]
  outboundMessageIntents      OutboundMessageIntent[]
  operatingHours              OrganizationOperatingHour[]
  locationOperatingHourOverrides LocationOperatingHourOverride[]
  guestContactDefaults GuestContactCompany?
  guestLocationPrivacy GuestLocationPrivacy[]
  guestPrivacyPublications GuestPrivacyPublication[]
  guestContactOverrides GuestContactLocation[]

  onboardingInvitations StaffOnboardingInvitation[]

  shiftStartPresenceMode ShiftPresenceMode @default(OFF) @map("shift_start_presence_mode")
  shiftEndPresenceMode ShiftPresenceMode @default(OFF) @map("shift_end_presence_mode")
  shiftPresenceMaxAccuracyMeters Int @default(50) @map("shift_presence_max_accuracy_meters")
  shiftPresenceMaxFixAgeSeconds Int @default(30) @map("shift_presence_max_fix_age_seconds")
  shiftPresenceRevision Int @default(1) @map("shift_presence_revision")
  @@map("organizations")
}

model Location {
  shiftPresenceManagementResults ShiftPresenceManagementResult[]
  id                                  String                       @id @default(uuid()) @db.Uuid
  organizationId                      String                       @map("organization_id") @db.Uuid
  name                                String
  code                                String
  addressText                         String                       @map("address_text")
  timezone                            String
  currency                            String
  status                              LocationStatus               @default(INACTIVE)
  checkInPhotosRequiredOverride       Boolean?                     @map("check_in_photos_required_override")
  handoffStandardMethodPolicyOverride HandoffStandardMethodPolicy? @map("handoff_standard_method_policy_override")
  trackingEnabledOverride             Boolean?                     @map("tracking_enabled_override")
  rawGpsRetentionDaysOverride         Int?                         @map("raw_gps_retention_days_override")
  valetServiceFeeOverride             Decimal?                     @map("valet_service_fee_override") @db.Decimal(14, 3)
  paymentServicePayerOverride         PaymentServicePayer?         @map("payment_service_payer_override")
  paymentMethodsPolicyOverride        PaymentMethodsPolicy?        @map("payment_methods_policy_override")
  tipsEnabledOverride                 Boolean?                     @map("tips_enabled_override")
  validationEnabledOverride           Boolean?                     @map("validation_enabled_override")
  releaseRequiresPaymentOverride      Boolean?                     @map("release_requires_payment_override")
  languageDefaultOverride             ManagementLanguage?          @map("language_default_override")
  ocrAssistEnabledOverride            Boolean?                     @map("ocr_assist_enabled_override")
  parkingSpotRequiredOverride         Boolean?                     @map("parking_spot_required_override")
  employeeRetrievalRequestedNotificationEnabledOverride Boolean?  @map("employee_retrieval_requested_notification_enabled_override")
  guestVehicleReadyNotificationEnabledOverride Boolean?           @map("guest_vehicle_ready_notification_enabled_override")
  slaTargetSeconds                    Int?                         @map("sla_target_seconds")
  brandDisplayNameOverride            String?                      @map("brand_display_name_override")
  brandPrimaryColorOverride           String?                      @map("brand_primary_color_override")
  createdAt                           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                           DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  acceptingIntake                     Boolean                      @default(false) @map("accepting_intake")
  organization             Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membershipLocationAccess MembershipLocationAccess[]
  shifts                   Shift[]
  parkingZones             ParkingZone[]
  parkingSpots             ParkingSpot[]
  keySlots                 KeySlot[]
  keyCustodyEvents         KeyCustodyEvent[]
  tasks                    Task[]
  emergencyTaskTakeovers   EmergencyTaskTakeoverOperation[]
  valetSessions            ValetSession[]
  auditEvents              AuditEvent[]
  payments                 Payment[]
  incidents                Incident[]
  incidentRecoveryIntents  IncidentRecoveryIntent[]
  conditionNotes           ConditionNote[]
  vehiclePhotos            VehiclePhoto[]
  conditionPhotoUploadOperations ConditionPhotoUploadOperation[]
  conditionPhotoUploadAttempts ConditionPhotoUploadAttempt[]
  vehiclePhotoVerifications VehiclePhotoVerification[]
  vehiclePhotoAvailability VehiclePhotoAvailability[]
  intakeOperations         IntakeOperation[]
  locationMapPoints        LocationMapPoint[]
  locationMapAreas         LocationMapArea[]
  taskTrackingSessions     TaskTrackingSession[]
  rawGpsSamples            RawGpsSample[]
  geofenceEvents           GeofenceEvent[]
  staffPushIntents         StaffPushIntent[]
  guestPushRegistrations   GuestPushRegistration[]
  guestPushIntents         GuestPushIntent[]
  outboundMessagingPolicies OutboundMessagingPolicy[]
  outboundMessageIntents OutboundMessageIntent[]
  operatingHoursOverrides  LocationOperatingHourOverride[]
  guestPrivacy             GuestLocationPrivacy?
  guestPrivacyPublications GuestPrivacyPublication[]
  guestContactOverrides    GuestContactLocation?

  shiftStartPresenceModeOverride ShiftPresenceMode? @map("shift_start_presence_mode_override")
  shiftEndPresenceModeOverride ShiftPresenceMode? @map("shift_end_presence_mode_override")
  shiftPresenceMaxAccuracyMetersOverride Int? @map("shift_presence_max_accuracy_meters_override")
  shiftPresenceMaxFixAgeSecondsOverride Int? @map("shift_presence_max_fix_age_seconds_override")
  shiftPresenceRevision Int @default(1) @map("shift_presence_revision")
  shiftPresenceZones ShiftPresenceZone[]
  shiftPresenceOperations ShiftPresenceOperation[]
  shiftPresenceDecisions ShiftPresenceDecision[]
  shiftPresenceExceptions ShiftPresenceException[]
  @@unique([organizationId, code], map: "locations_organization_id_code_key")
  @@unique([organizationId, id], map: "locations_organization_id_id_key")
  @@map("locations")
}

model OrganizationOperatingHour {
  organizationId String           @map("organization_id") @db.Uuid
  weekday        OperatingWeekday
  isClosed       Boolean          @map("is_closed")
  opensAt        DateTime?        @map("opens_at") @db.Time(0)
  closesAt       DateTime?        @map("closes_at") @db.Time(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, weekday])
  @@map("organization_operating_hours")
}

model LocationOperatingHourOverride {
  organizationId String           @map("organization_id") @db.Uuid
  locationId     String           @map("location_id") @db.Uuid
  weekday        OperatingWeekday
  isClosed       Boolean          @map("is_closed")
  opensAt        DateTime?        @map("opens_at") @db.Time(0)
  closesAt       DateTime?        @map("closes_at") @db.Time(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, locationId, weekday])
  @@map("location_operating_hours_overrides")
}

// #316: Legal drafts are Location-owned. Publishing creates immutable snapshots;
// the active pointer may be cleared without deleting previous publications.
model GuestLocationPrivacy {
  organizationId String @map("organization_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  draftEnText String? @map("draft_en_text") @db.Text
  draftEnUrl String? @map("draft_en_url") @db.VarChar(2048)
  draftArText String? @map("draft_ar_text") @db.Text
  draftArUrl String? @map("draft_ar_url") @db.VarChar(2048)
  revision Int @default(0)
  publishedVersion Int? @map("published_version")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "guest_location_privacy_organization_id_fkey")
  location Location @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, map: "guest_location_privacy_location_fkey")
  publications GuestPrivacyPublication[] @relation("GuestPrivacyHistory")
  activePublication GuestPrivacyPublication? @relation("GuestPrivacyActive", fields: [organizationId, locationId, publishedVersion], references: [organizationId, locationId, version], onDelete: Restrict, map: "guest_location_privacy_active_publication_fkey")

  @@id([organizationId, locationId])
  @@map("guest_location_privacy")
}

model GuestPrivacyPublication {
  organizationId String @map("organization_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  version Int
  enText String? @map("en_text") @db.Text
  enUrl String? @map("en_url") @db.VarChar(2048)
  arText String? @map("ar_text") @db.Text
  arUrl String? @map("ar_url") @db.VarChar(2048)
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "guest_privacy_publications_organization_id_fkey")
  location Location @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, map: "guest_privacy_publications_location_fkey")
  privacy GuestLocationPrivacy @relation("GuestPrivacyHistory", fields: [organizationId, locationId], references: [organizationId, locationId], onDelete: Restrict, map: "guest_privacy_publications_privacy_fkey")
  activeFor GuestLocationPrivacy[] @relation("GuestPrivacyActive")

  @@id([organizationId, locationId, version])
  @@index([organizationId, locationId, publishedAt(sort: Desc)], map: "guest_privacy_publications_scope_date_idx")
  @@map("guest_privacy_publications")
}

model GuestContactCompany {
  organizationId String @id @map("organization_id") @db.Uuid
  displayName String? @map("display_name") @db.VarChar(240)
  phone String? @db.VarChar(32)
  supportUrl String? @map("support_url") @db.VarChar(240)
  hours String? @db.VarChar(240)
  hoursConfirmed Boolean @default(false) @map("hours_confirmed")
  revision Int @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("guest_contact_company_defaults")
}

model GuestContactLocation {
  organizationId String @map("organization_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  displayNameMode GuestContactFieldMode @default(INHERIT) @map("display_name_mode")
  displayName String? @map("display_name") @db.VarChar(240)
  phoneMode GuestContactFieldMode @default(INHERIT) @map("phone_mode")
  phone String? @db.VarChar(32)
  supportUrlMode GuestContactFieldMode @default(INHERIT) @map("support_url_mode")
  supportUrl String? @map("support_url") @db.VarChar(240)
  hoursMode GuestContactFieldMode @default(INHERIT) @map("hours_mode")
  hours String? @db.VarChar(240)
  hoursConfirmed Boolean @default(false) @map("hours_confirmed")
  revision Int @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "guest_contact_location_overrides_organization_id_fkey")
  location Location @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, map: "guest_contact_location_overrides_location_fkey")

  @@id([organizationId, locationId])
  @@map("guest_contact_location_overrides")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique(map: "users_email_key")
  phone        String?
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)

  memberships                  OrganizationMembership[]
  conditionPhotoUploadAdmission ConditionPhotoUploadAdmission?
  staffAuthSessions            StaffAuthSession[]
  mfaTotpFactors               UserMfaTotpFactor[]
  accountSecuritySubjectEvents AccountSecurityAuditEvent[] @relation("AccountSecuritySubjectUser")
  accountSecurityActorEvents   AccountSecurityAuditEvent[] @relation("AccountSecurityActorUser")

  @@map("users")
}

model StaffAuthSession {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  currentAccessTokenHash String    @unique(map: "staff_auth_sessions_current_access_token_hash_key") @map("current_access_token_hash")
  accessExpiresAt        DateTime  @map("access_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt      DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastRotatedAt          DateTime  @map("last_rotated_at") @db.Timestamptz(3)
  mfaAuthenticatedAt     DateTime? @map("mfa_authenticated_at") @db.Timestamptz(3)
  mfaFactorId            String?   @map("mfa_factor_id") @db.Uuid
  lastAdminActivityAt    DateTime? @map("last_admin_activity_at") @db.Timestamptz(3)

  user               User                     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mfaFactor          UserMfaTotpFactor?       @relation(fields: [userId, mfaFactorId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict, map: "staff_auth_sessions_user_mfa_factor_id_fkey")
  refreshCredentials StaffRefreshCredential[]
  pushRegistrations  StaffPushRegistration[]

  @@index([userId, revokedAt, absoluteExpiresAt], map: "staff_auth_sessions_user_id_status_idx")
  @@map("staff_auth_sessions")
}

model UserMfaTotpFactor {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  state                 MfaTotpFactorState @default(PENDING)
  protectedSecret       String             @map("protected_secret")
  lastAcceptedStep      BigInt?            @map("last_accepted_step")
  recoverySetGeneration Int                @default(0) @map("recovery_set_generation")
