{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_ORIGIN", "NEXT_PUBLIC_CUSTOMER_APP_ORIGIN"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "@valet/api#test": {
      "cache": false,
      "env": ["TEST_DATABASE_URL", "MIGRATION_DATABASE_URL"],
      "dependsOn": ["^test"],
      "outputs": []
    },
    "@valet/database#test": {
      "cache": false,
      "env": ["TEST_DATABASE_URL", "MIGRATION_DATABASE_URL"],
      "dependsOn": ["^test"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
